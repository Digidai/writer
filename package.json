{
  "name": "writer",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet, input-focused writing surface. You write; an agent files everything away.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute writer-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute writer-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.122.0"
  }
}
