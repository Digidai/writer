{
  "name": "writer",
  "version": "0.14.0",
  "private": true,
  "description": "A quiet, input-focused writing surface. You write; an agent files everything away.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --no-warnings --import ./test/helpers/register.js --test test/*.test.js",
    "check": "for f in src/*.js public/*.js; do node --check \"$f\" || exit 1; done",
    "diagrams": "python3 scripts/make-diagrams.py",
    "db:local": "wrangler d1 migrations apply writer-db --local",
    "db:remote": "wrangler d1 migrations apply writer-db --remote"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Digidai/writer.git"
  },
  "homepage": "https://writer.genedai.md",
  "devDependencies": {
    "@fontsource/noto-sans-sc": "^5.3.0",
    "wrangler": "^4.122.0"
  }
}
